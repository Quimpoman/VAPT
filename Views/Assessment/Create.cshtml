@model EVOLVE_VAPT.ViewModels.Assessment.AssessmentFormViewModel

@{
    ViewData["Title"] = "New Assessment";
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            New Assessment
        </h1>

        <p class="page-description">
            Create a new vulnerability assessment project.
        </p>
    </div>

</div>


<form asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()


    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>


    <section class="dashboard-panel dashboard-panel-spacing">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Assessment Information
                </h2>

                <span class="panel-description">
                    Basic information describing the assessment.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <partial name="_AssessmentForm"
                     model="Model" />

        </div>

    </section>


    <div class="d-flex justify-content-end gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Cancel

        </a>

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-check-lg me-1"></i>

            Create Assessment

        </button>

    </div>

</form>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}