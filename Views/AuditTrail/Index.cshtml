@model EVOLVE_VAPT.ViewModels.AuditTrail.AuditTrailIndexViewModel

@{
    ViewData["Title"] = "Audit Trail";
}


<div class="page-header">

    <div>

        <h1 class="page-title">
            Audit Trail
        </h1>

        <p class="page-description">
            Review security, administrative,
            and system activity recorded by EVOLVE VAPT.
        </p>

    </div>

</div>


<!-- FILTERS -->
<section class="dashboard-panel">

    <div class="panel-header">

        <div class="panel-title-group">

            <h2 class="panel-title">
                Filters
            </h2>

            <span class="panel-description">
                Narrow the audit history by user,
                module, action, date, or result.
            </span>

        </div>

    </div>


    <div class="panel-body">

        <form method="get"
              asp-action="Index">

            <div class="row g-3">


                <!-- SEARCH -->
                <div class="col-lg-4 col-md-6">

                    <label asp-for="Search"
                           class="form-label">
                        Search
                    </label>

                    <input asp-for="Search"
                           class="form-control"
                           placeholder="Description, record, IP..." />

                </div>


                <!-- USER -->
                <div class="col-lg-4 col-md-6">

                    <label asp-for="UserName"
                           class="form-label">
                        User
                    </label>

                    <select asp-for="UserName"
                            class="form-select">

                        <option value="">
                            All Users
                        </option>

                        @foreach (var user
                                                in Model.Users)
                        {
                            <option value="@user">
                                @user
                            </option>
                        }

                    </select>

                </div>


                <!-- MODULE -->
                <div class="col-lg-4 col-md-6">

                    <label asp-for="Module"
                           class="form-label">
                        Module
                    </label>

                    <select asp-for="Module"
                            class="form-select">

                        <option value="">
                            All Modules
                        </option>

                        @foreach (var module
                                                in Model.Modules)
                        {
                            <option value="@module">
                                @module
                            </option>
                        }

                    </select>

                </div>


                <!-- ACTION -->
                <div class="col-lg-4 col-md-6">

                    <label asp-for="ActionType"
                           class="form-label">
                        Action
                    </label>

                    <select asp-for="ActionType"
                            class="form-select">

                        <option value="">
                            All Actions
                        </option>

                        @foreach (var action
                                                in Model.ActionTypes)
                        {
                            <option value="@action">
                                @action
                            </option>
                        }

                    </select>

                </div>


                <!-- RESULT -->
                <div class="col-lg-4 col-md-6">

                    <label asp-for="IsSuccessful"
                           class="form-label">
                        Result
                    </label>

                    <select asp-for="IsSuccessful"
                            class="form-select">

                        <option value="">
                            All Results
                        </option>

                        <option value="true">
                            Successful
                        </option>

                        <option value="false">
                            Failed
                        </option>

                    </select>

                </div>


                <!-- FROM -->
                <div class="col-lg-2 col-md-3">

                    <label asp-for="DateFrom"
                           class="form-label">
                        From
                    </label>

                    <input asp-for="DateFrom"
                           type="date"
                           class="form-control" />

                </div>


                <!-- TO -->
                <div class="col-lg-2 col-md-3">

                    <label asp-for="DateTo"
                           class="form-label">
                        To
                    </label>

                    <input asp-for="DateTo"
                           type="date"
                           class="form-control" />

                </div>

            </div>


            <div class="mt-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-search me-1"></i>

                    Apply Filters

                </button>


                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Clear

                </a>

            </div>

        </form>

    </div>

</section>


<!-- RESULTS -->
<section class="dashboard-panel dashboard-panel-spacing">

    <div class="panel-header">

        <div class="panel-title-group">

            <h2 class="panel-title">
                Activity
            </h2>

            <span class="panel-description">
                @Model.TotalCount audit record(s) found.
            </span>

        </div>

    </div>


    @if (!Model.Items.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <h3 class="empty-state-title">
                No audit records found
            </h3>

            <p class="empty-state-description">
                No recorded events match the
                selected filters.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>

                    <tr>
                        <th>Date / Time</th>
                        <th>User</th>
                        <th>Module</th>
                        <th>Action</th>
                        <th>Description</th>
                        <th>Result</th>
                        <th></th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td class="text-nowrap">

                                @item.CreatedDate.ToString("MMM dd, yyyy hh:mm:ss tt")

                            </td>


                            <td>

                                @(item.UserName
                                                        ?? "System")

                            </td>


                            <td>

                                <span class="badge bg-secondary">
                                    @item.Module
                                </span>

                            </td>


                            <td>

                                <code>
                                    @item.ActionType
                                </code>

                            </td>


                            <td>

                                @(item.Description
                                                        ?? "-")

                    </td>


                            <td>

                        @if (item.IsSuccessful)
                                {
                                    <span class="badge bg-success">
                                        Success
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Failed
                                    </span>
                                }

                            </td>


                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@item.AuditTrailID"
                                   class="btn btn-sm btn-outline-primary">

                                    View

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- PAGINATION -->
        @if (Model.TotalPages > 1)
        {
            <div class="panel-body border-top">

                <div class="d-flex
                                    justify-content-between
                                    align-items-center">

                    <span class="text-muted">

                        Page @Model.Page
                        of @Model.TotalPages

                    </span>


                    <div class="d-flex gap-2">

                        @if (Model.Page > 1)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-userName="@Model.UserName"
                               asp-route-module="@Model.Module"
                               asp-route-actionType="@Model.ActionType"
                               asp-route-isSuccessful="@Model.IsSuccessful"
                               asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                               asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                               class="btn btn-sm btn-outline-secondary">

                                Previous

                            </a>
                        }


                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-userName="@Model.UserName"
                               asp-route-module="@Model.Module"
                               asp-route-actionType="@Model.ActionType"
                               asp-route-isSuccessful="@Model.IsSuccessful"
                               asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                               asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                               class="btn btn-sm btn-outline-secondary">

                                Next

                            </a>
                        }

                    </div>

                </div>

            </div>
        }
    }

</section>