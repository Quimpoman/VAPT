@using EVOLVE_VAPT.Security
@model EVOLVE_VAPT.ViewModels.ScanProfile.ScanProfileDetailsViewModel

@{
    ViewData["Title"] = "Scan Profile Details";
}

<div class="d-flex gap-2">

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back

    </a>


    @if (User.IsInRole(AppRoles.Administrator) ||
        User.IsInRole(AppRoles.SecurityAnalyst))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.ScanProfileID"
           class="btn btn-primary">

            <i class="bi bi-pencil me-1"></i>
            Edit

        </a>
        <button type="button"
                class="btn btn-outline-danger"
                data-bs-toggle="modal"
                data-bs-target="#deactivateProfileModal">

            <i class="bi bi-x-circle me-1"></i>

            Deactivate

        </button>
    }

</div>
<div class="page-header">

    <div>

        <h1 class="page-title">
            @Model.ProfileName
        </h1>

        <p class="page-description">
            @Model.ProfileCode
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Back

    </a>

</div>


<div class="dashboard-grid">

    <section class="dashboard-panel">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Profile Information
                </h2>

                <span class="panel-description">
                    General scanner configuration.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <div class="detail-grid">

                <div class="detail-item">

                    <span class="detail-label">
                        Scanner
                    </span>

                    <span class="detail-value">
                        @Model.ScannerTypeName
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Profile Code
                    </span>

                    <span class="detail-value">
                        @Model.ProfileCode
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Timeout
                    </span>

                    <span class="detail-value">
                        @Model.TimeoutMinutes minutes
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Maximum Concurrency
                    </span>

                    <span class="detail-value">
                        @Model.MaxConcurrency
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Intrusive
                    </span>

                    <span class="detail-value">
                        @(Model.IsIntrusive ? "Yes" : "No")
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Explicit Approval
                    </span>

                    <span class="detail-value">
                        @(Model.RequiresExplicitApproval
                                                ? "Required"
                                                : "Standard")
                    </span>

                </div>


                <div class="detail-item detail-item-full">

                    <span class="detail-label">
                        Description
                    </span>

                    <span class="detail-value">
                        @(Model.Description ?? "-")
                    </span>

                </div>

            </div>

        </div>

    </section>

</div>


<section class="dashboard-panel dashboard-panel-spacing">

    <div class="panel-header">

        <div class="panel-title-group">

            <h2 class="panel-title">
                Scanner Options
            </h2>

            <span class="panel-description">
                Allow-listed configuration options
                supported by @Model.ScannerTypeName.
            </span>

        </div>

    </div>


    @if (!Model.Options.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-sliders"></i>
            </div>

            <h3 class="empty-state-title">
                No scanner options available
            </h3>

            <p class="empty-state-description">
                No active options are configured for
                this scanner type.
            </p>

        </div>
    }
    else
    {
        <div class="panel-body">

            @foreach (var option in Model.Options)
            {
                <div class="border rounded p-3 mb-3">

                    <div class="d-flex
                                        justify-content-between
                                        align-items-start
                                        mb-2">

                        <div>

                            <strong>
                                @option.OptionName
                            </strong>

                            <div class="text-muted small">
                                @option.OptionCode
                            </div>

                        </div>


                        @if (option.IsConfigured)
                        {
                            <span class="badge text-bg-success">
                                Configured
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">
                                Default
                            </span>
                        }

                    </div>


                    @if (!string.IsNullOrWhiteSpace(
                                option.Description))
                    {
                        <p class="text-muted small">
                            @option.Description
                        </p>
                    }


                    @if (User.IsInRole(AppRoles.Administrator) ||
                                User.IsInRole(AppRoles.SecurityAnalyst))
                    {
                        <form asp-action="SaveOption"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="scanProfileId"
                                   value="@Model.ScanProfileID" />

                            <input type="hidden"
                                   name="scannerOptionId"
                                   value="@option.ScannerOptionID" />


                            <div class="row align-items-end">

                                <div class="col-md-8">

                                    <label class="form-label">
                                        Value
                                    </label>


                                    @if (option.ValueType == "BOOLEAN")
                                    {
                                        <select name="optionValue"
                                                class="form-select">

                                            <option value="true"
                                                    selected="@(option.OptionValue == "true")">
                                                True
                                            </option>

                                            <option value="false"
                                                    selected="@(option.OptionValue == "false")">
                                                False
                                            </option>

                                        </select>
                                    }
                                    else if (option.ValueType == "INTEGER")
                                    {
                                        <input type="number"
                                               name="optionValue"
                                               value="@option.OptionValue"
                                               class="form-control" />
                                    }
                                    else
                                    {
                                        <input type="text"
                                               name="optionValue"
                                               value="@option.OptionValue"
                                               class="form-control"
                                               maxlength="500" />
                                    }

                                </div>


                                <div class="col-md-4">

                                    <button type="submit"
                                            class="btn btn-primary">

                                        Save Option

                                    </button>

                                </div>

                            </div>

                        </form>
                    }
                    else
                    {
                        <div>
                            <strong>Value:</strong>
                            @option.OptionValue
                        </div>
                    }

                </div>
            }

        </div>
    }

</section>

@if (User.IsInRole(AppRoles.Administrator) ||
     User.IsInRole(AppRoles.SecurityAnalyst))
{
    <div class="modal fade"
         id="deactivateProfileModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Deactivate Scan Profile
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p>
                        Deactivate
                        <strong>@Model.ProfileName</strong>?
                    </p>


                    <div class="alert alert-warning mb-0">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        This profile will no longer be available
                        for future Scan Jobs. Its historical
                        record will remain available.

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <form asp-action="Deactivate"
                          asp-route-id="@Model.ScanProfileID"
                          method="post">

                        @Html.AntiForgeryToken()


                        <button type="submit"
                                class="btn btn-danger">

                            Deactivate Profile

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}