@using EVOLVE_VAPT.Security
@model EVOLVE_VAPT.ViewModels.Target.TargetDetailsViewModel

@{
    ViewData["Title"] = "Target Details";
}


<div class="page-header">

    <div>

        <h1 class="page-title">
            @Model.TargetName
        </h1>

        <p class="page-description">
            @Model.TargetValue
        </p>

    </div>


    <div class="d-flex gap-2">

        <a asp-action="Index"
           asp-route-assessmentId="@Model.AssessmentID"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back

        </a>


        @if (User.IsInRole(AppRoles.Administrator) ||
                User.IsInRole(AppRoles.SecurityAnalyst))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.AssessmentTargetID"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>

                Edit

            </a>
        }
        @if (User.IsInRole(AppRoles.Administrator) ||
                User.IsInRole(AppRoles.SecurityAnalyst))
        {
            <button type="button"
                    class="btn btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deactivateTargetModal">

                <i class="bi bi-x-circle me-1"></i>

                Deactivate

            </button>
        }

    </div>

</div>

<div class="dashboard-grid">

    <!-- TARGET INFORMATION -->
    <section class="dashboard-panel">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Target Information
                </h2>

                <span class="panel-description">
                    System or endpoint assigned to this assessment.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <div class="detail-grid">

                <div class="detail-item">

                    <span class="detail-label">
                        Target Name
                    </span>

                    <span class="detail-value">
                        @Model.TargetName
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Target Type
                    </span>

                    <span class="detail-value">
                        @Model.TargetTypeName
                    </span>

                </div>


                <div class="detail-item detail-item-full">

                    <span class="detail-label">
                        Target Value
                    </span>

                    <span class="detail-value">
                        @Model.TargetValue
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- AUTHORIZATION INFORMATION -->
    <section class="dashboard-panel">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Authorization
                </h2>

                <span class="panel-description">
                    Approval state and authorization window.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <div class="detail-grid">

                <div class="detail-item">

                    <span class="detail-label">
                        Status
                    </span>

                    <span class="detail-value">
                        @Model.AuthorizationStatusName
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Reference
                    </span>

                    <span class="detail-value">
                        @(Model.AuthorizationReference ?? "-")
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Valid From
                    </span>

                    <span class="detail-value">

                        @(Model.AuthorizationValidFrom.HasValue
                                                ? Model.AuthorizationValidFrom.Value
                                                .ToString("MMM dd, yyyy")
                                                : "-")

                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Valid Until
                    </span>

                    <span class="detail-value">

                        @(Model.AuthorizationValidUntil.HasValue
                                                ? Model.AuthorizationValidUntil.Value
                                                .ToString("MMM dd, yyyy")
                                                : "-")

                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Authorized By
                    </span>

                    <span class="detail-value">
                        @(Model.AuthorizedByEmail ?? "-")
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Authorized Date
                    </span>

                    <span class="detail-value">

                        @(Model.AuthorizedDate.HasValue
                                                ? Model.AuthorizedDate.Value
                                                .ToString("MMM dd, yyyy hh:mm tt")
                                                : "-")

                    </span>

                </div>


                <div class="detail-item detail-item-full">

                    <span class="detail-label">
                        Authorization Notes
                    </span>

                    <span class="detail-value">
                        @(Model.AuthorizationNotes ?? "-")
                    </span>

                </div>

            </div>

        </div>

    </section>

</div>

@if (Model.AuthorizationStatusCode == "PENDING" &&
     (User.IsInRole(AppRoles.Administrator) ||
      User.IsInRole(AppRoles.Reviewer)))
{
    <section class="dashboard-panel dashboard-panel-spacing">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Authorization Decision
                </h2>

                <span class="panel-description">
                    Review this target before allowing
                    future scanner activity.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <div class="alert alert-warning">

                <i class="bi bi-shield-exclamation me-2"></i>

                This target is currently pending approval
                and is not eligible for scanning.

            </div>


            <div class="d-flex gap-2">

                <form asp-action="Approve"
                      asp-route-id="@Model.AssessmentTargetID"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-shield-check me-1"></i>

                        Approve Target

                    </button>

                </form>


                <button type="button"
                        class="btn btn-outline-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#rejectTargetModal">

                    <i class="bi bi-x-circle me-1"></i>

                    Reject Target

                </button>

            </div>

        </div>

    </section>
}

@if (Model.AuthorizationStatusCode == "PENDING")
{
    <div class="modal fade"
         id="rejectTargetModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-action="Reject"
                      asp-route-id="@Model.AssessmentTargetID"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div class="modal-header">

                        <h5 class="modal-title">
                            Reject Target
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <p>
                            Reject
                            <strong>@Model.TargetName</strong>?
                        </p>


                        <label for="reason"
                               class="form-label">

                            Reason

                        </label>


                        <textarea id="reason"
                              name="reason"
                              class="form-control"
                              rows="3"
                              maxlength="500"
                              required></textarea>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>


                        <button type="submit"
                                class="btn btn-danger">

                            Reject Target

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}

<section class="dashboard-panel dashboard-panel-spacing">

    <div class="panel-header">

        <div class="panel-title-group">

            <h2 class="panel-title">
                Scope Rules
            </h2>

            <span class="panel-description">
                Explicit Include and Exclude boundaries
                for this target.
            </span>

        </div>


        @if (User.IsInRole(AppRoles.Administrator) ||
                User.IsInRole(AppRoles.SecurityAnalyst))
        {
            <a asp-action="CreateScopeRule"
               asp-route-assessmentTargetId="@Model.AssessmentTargetID"
               class="panel-action">

                <i class="bi bi-plus-lg"></i>

                Add Scope Rule

            </a>
        }

    </div>


    @if (!Model.ScopeRules.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-bounding-box"></i>
            </div>

            <h3 class="empty-state-title">
                No scope rules configured
            </h3>

            <p class="empty-state-description">
                Add Include or Exclude rules to define
                the permitted testing boundary.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Rule Type</th>
                        <th>Rule Value</th>
                        <th>Description</th>
                        <th>Created By</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var rule in Model.ScopeRules)
                    {
                        <tr>

                            <td>
                                @rule.ScopeRuleTypeName
                            </td>

                            <td>
                                <code>@rule.RuleValue</code>
                            </td>

                            <td>
                                @(rule.Description ?? "-")
                            </td>

                            <td>
                                @(rule.CreatedByEmail ?? "-")
                            </td>

                            <td class="text-end">

                                @if (User.IsInRole(AppRoles.Administrator) ||
                                                        User.IsInRole(AppRoles.SecurityAnalyst))
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deactivateScopeRuleModal-@rule.AssessmentScopeRuleID">

                                        Deactivate

                                    </button>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!--
            Bootstrap modals must remain outside the table markup.
            Each rule gets a unique modal ID based on its primary key.
        -->
        @foreach (var rule in Model.ScopeRules)
        {
            <div class="modal fade"
                 id="deactivateScopeRuleModal-@rule.AssessmentScopeRuleID"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content">

                        <div class="modal-header">

                            <h5 class="modal-title">
                                Deactivate Scope Rule
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal">
                            </button>

                        </div>


                        <div class="modal-body">

                            <p>
                                Deactivate this
                                <strong>@rule.ScopeRuleTypeName</strong>
                                rule?
                            </p>

                            <code>
                                @rule.RuleValue
                            </code>


                            @if (Model.AuthorizationStatusCode == "APPROVED")
                            {
                                <div class="alert alert-warning mt-3 mb-0">

                                    <i class="bi bi-shield-exclamation me-2"></i>

                                    This target is currently approved.
                                    Changing its scope will return it to
                                    <strong>Pending Approval</strong>.

                                </div>
                            }

                        </div>


                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">

                                Cancel

                            </button>


                            <form asp-action="DeactivateScopeRule"
                                  asp-route-id="@rule.AssessmentScopeRuleID"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger">

                                    Deactivate Rule

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>
        }
    }

</section>

@if (User.IsInRole(AppRoles.Administrator) ||
     User.IsInRole(AppRoles.SecurityAnalyst))
{
    <div class="modal fade"
         id="deactivateTargetModal"
         tabindex="-1"
         aria-labelledby="deactivateTargetModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="deactivateTargetModalLabel">

                        Deactivate Target

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p>
                        Are you sure you want to deactivate
                        <strong>@Model.TargetName</strong>?
                    </p>


                    <div class="alert alert-warning mb-0">

                        <i class="bi bi-shield-exclamation me-2"></i>

                        The target will be removed from the
                        active Assessment scope and its active
                        scope rules will also be deactivated.

                        Historical records and AuditTrail entries
                        will remain available.

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <form asp-action="Deactivate"
                          asp-route-id="@Model.AssessmentTargetID"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">

                            Deactivate Target

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}