@using EVOLVE_VAPT.Security
@model EVOLVE_VAPT.ViewModels.Remediation.RemediationDetailsViewModel

@{
    ViewData["Title"] = "Remediation Details";

    var canManage =
        User.IsInRole(AppRoles.Administrator) ||
        User.IsInRole(AppRoles.SecurityAnalyst) ||
        User.IsInRole(AppRoles.Reviewer);
}
<div class="page-header">

    <div>

        <h1 class="page-title">
            @Model.FindingTitle
        </h1>

        <p class="page-description">
            Remediation Cycle @Model.CycleNo
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back

    </a>

</div>


<section class="dashboard-panel">

    <div class="panel-body">

        <div class="detail-grid">

            <div class="detail-item">

                <span class="detail-label">
                    Status
                </span>

                <span class="detail-value">
                    @Model.RemediationStatusName
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Finding Severity
                </span>

                <span class="detail-value">
                    @Model.SeverityName
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Assigned To
                </span>

                <span class="detail-value">
                    @(Model.AssignedToEmail
                                        ?? "Unassigned")
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Target Date
                </span>

                <span class="detail-value">

                    @(Model.TargetDate.HasValue
                                        ? Model.TargetDate.Value
                                        .ToString("MMM dd, yyyy")
                                        : "-")

                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Started
                </span>

                <span class="detail-value">
                    @Model.StartedDate.ToString(
                                        "MMM dd, yyyy hh:mm tt")
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Finding Status
                </span>

                <span class="detail-value">
                    @Model.FindingStatusName
                </span>

            </div>

        </div>

    </div>

</section>


<section class="dashboard-panel dashboard-panel-spacing">

    <div class="panel-header">
        <h2 class="panel-title">
            Remediation Notes
        </h2>
    </div>

    <div class="panel-body">

        @(string.IsNullOrWhiteSpace(
                Model.RemediationNotes)
                ? "No remediation notes have been provided."
                : Model.RemediationNotes)

    </div>

</section>
@if (canManage &&
     Model.RemediationStatusCode == "IN_PROGRESS")
{
    <div class="d-flex gap-2 mt-3">

        <a asp-action="Edit"
           asp-route-id="@Model.FindingRemediationID"
           class="btn btn-outline-primary">

            <i class="bi bi-pencil me-1"></i>

            Edit Remediation

        </a>


        <button type="button"
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#submitRetestModal">

            Submit for Retest

        </button>

    </div>
}
@if (canManage &&
     Model.RemediationStatusCode == "IN_PROGRESS")
{
    <div class="modal fade"
         id="submitRetestModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <form asp-action="SubmitRetest"
                      asp-route-id="@Model.FindingRemediationID"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div class="modal-header">

                        <h5 class="modal-title">
                            Submit for Retest
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body">

                        <p>
                            Confirm that remediation work is ready
                            for security verification.
                        </p>


                        <label class="form-label">
                            Submission Notes
                        </label>

                        <textarea name="submissionNotes"
                              class="form-control"
                              rows="4"
                              maxlength="2000"
                              required></textarea>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">

                            Back

                        </button>


                        <button type="submit"
                                class="btn btn-success">

                            Submit for Retest

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}
@if (Model.RemediationStatusCode ==
     "SUBMITTED_RETEST")
{
    <section class="dashboard-panel dashboard-panel-spacing">

        <div class="panel-header">

            <h2 class="panel-title">
                Retest Submission
            </h2>

        </div>


        <div class="panel-body">

            <div class="detail-grid">

                <div class="detail-item">

                    <span class="detail-label">
                        Submitted By
                    </span>

                    <span class="detail-value">
                        @(Model.SubmittedByEmail ?? "-")
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Submitted
                    </span>

                    <span class="detail-value">

                        @(Model.SubmittedForRetestDate.HasValue
                                            ? Model.SubmittedForRetestDate.Value.ToString("MMM dd, yyyy hh:mm tt"): "-")

                </span>

                </div>

            </div>


            <div class="mt-3">

                <strong>
                    Submission Notes
                </strong>

                <div class="mt-1">
                    @(Model.SubmissionNotes ?? "-")
                </div>

            </div>

        </div>

    </section>
}
@{
    var canCreateRetest =
        User.IsInRole(AppRoles.Administrator) ||
        User.IsInRole(AppRoles.SecurityAnalyst);
}
@if (canCreateRetest &&
     Model.RemediationStatusCode ==
        "SUBMITTED_RETEST" &&
     Model.FindingStatusCode ==
        "RETEST")
{
    <section class="dashboard-panel dashboard-panel-spacing">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Retesting
                </h2>

                <span class="panel-description">
                    Create a new Scan Job to verify the
                    remediation work.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <form asp-controller="Retest"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="remediationId"
                       value="@Model.FindingRemediationID" />


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-arrow-repeat me-1"></i>

                    Create Retest Scan

                </button>

            </form>

        </div>

    </section>
}