@model IReadOnlyList<
EVOLVE_VAPT.ViewModels.Administration.UserListItemViewModel >

@{
    ViewData["Title"] = "User Management";
}


<div class="page-header">

    <div>
        <h1 class="page-title">
            User Management
        </h1>

        <p class="page-description">
            Manage EVOLVE VAPT users,
            account status, and access roles.
        </p>
    </div>
    <div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-person-plus me-1"></i>

            Create User

        </a>

    </div>

</div>


<section class="dashboard-panel">

    <div class="panel-header">

        <div class="panel-title-group">

            <h2 class="panel-title">
                Users
            </h2>

            <span class="panel-description">
                Registered application users and
                their assigned security roles.
            </span>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-people"></i>
            </div>

            <h3 class="empty-state-title">
                No users found
            </h3>

            <p class="empty-state-description">
                There are currently no Identity
                users registered in the system.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>User</th>
                        <th>Roles</th>
                        <th>Email Confirmed</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>

                            <td>

                                <div>
                                    <strong>
                                        @user.Email
                                    </strong>
                                </div>

                                @if (user.UserName != user.Email)
                                {
                                    <small class="text-muted">
                                        @user.UserName
                                    </small>
                                }

                            </td>


                            <td>

                                @if (user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="badge bg-secondary me-1">
                                            @role
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No role assigned
                                    </span>
                                }

                            </td>


                            <td>

                                @if (user.EmailConfirmed)
                                {
                                    <span>
                                        <i class="bi bi-check-circle me-1"></i>
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No
                                    </span>
                                }

                            </td>


                            <td>

                                @if (user.Status == "Active")
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else if (user.Status == "Locked")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Locked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Disabled
                                    </span>
                                }

                            </td>


                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@user.UserID"
                                   class="btn btn-sm btn-outline-primary">

                                    View

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</section>