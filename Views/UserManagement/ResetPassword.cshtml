@model EVOLVE_VAPT.ViewModels.Administration.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}


<div class="page-header">

    <div>

        <h1 class="page-title">
            Reset Password
        </h1>

        <p class="page-description">
            Assign a new password to
            @Model.Email.
        </p>

    </div>


    <div>

        <a asp-action="Details"
           asp-route-id="@Model.UserID"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back

        </a>

    </div>

</div>


<section class="dashboard-panel">

    <div class="panel-header">

        <div class="panel-title-group">

            <h2 class="panel-title">
                New Password
            </h2>

            <span class="panel-description">
                The new password must satisfy
                the configured Identity password policy.
            </span>

        </div>

    </div>


    <div class="panel-body">

        <div class="alert alert-warning">

            <i class="bi bi-shield-exclamation me-1"></i>

            You are resetting the password for

            <strong>
                @Model.Email
            </strong>.

        </div>


        <form asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()


            <input asp-for="UserID"
                   type="hidden" />

            <input asp-for="Email"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="NewPassword"
                           class="form-label">
                    </label>

                    <input asp-for="NewPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="NewPassword"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                    </label>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="mt-3">

                <div class="form-text">
                    Minimum 8 characters with uppercase,
                    lowercase, number, and special character.
                </div>

            </div>


            <div class="mt-4 d-flex gap-2">

                <button type="submit"
                        class="btn btn-warning">

                    <i class="bi bi-key me-1"></i>

                    Reset Password

                </button>


                <a asp-action="Details"
                   asp-route-id="@Model.UserID"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</section>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}