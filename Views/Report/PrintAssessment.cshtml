@model EVOLVE_VAPT.ViewModels.Report.AssessmentReportViewModel

@{
    Layout = "_ReportLayout";

    ViewData["Title"] =
        $"Assessment Report - {Model.AssessmentCode}";
}
<div class="report-actions no-print">

    <button type="button"
            class="btn btn-primary"
            onclick="window.print();">

        Print / Save as PDF

    </button>

</div>
<header class="report-header">

    <div class="report-company">
        EVOLVE SOFTWARE SOLUTIONS INC.
    </div>


    <h1 class="report-title">
        Vulnerability Assessment &
        Penetration Testing Report
    </h1>


    <div class="report-subtitle">

        @Model.AssessmentCode
        —
        @Model.AssessmentName

    </div>

</header>
<section class="report-section">

    <div class="row">

        <div class="col-6">

            <div class="report-label">
                Assessment
            </div>

            <strong>
                @Model.AssessmentName
            </strong>

        </div>


        <div class="col-3">

            <div class="report-label">
                Status
            </div>

            <strong>
                @Model.AssessmentStatusName
            </strong>

        </div>


        <div class="col-3">

            <div class="report-label">
                Generated
            </div>

            <strong>
                @Model.GeneratedDate.ToString("MMM dd, yyyy HH:mm")
            </strong>

        </div>

    </div>


    <div class="mt-3">

        <div class="report-label">
            Generated By
        </div>

        <div>
            @Model.GeneratedBy
        </div>

    </div>

</section>
<section class="report-section">

    <h2 class="report-section-title">
        1. Assessment Overview
    </h2>


    <table class="table table-bordered">

        <tbody>

            <tr>
                <th style="width:25%">
                    Assessment Code
                </th>

                <td>
                    @Model.AssessmentCode
                </td>
            </tr>


            <tr>
                <th>
                    Assessment Name
                </th>

                <td>
                    @Model.AssessmentName
                </td>
            </tr>


            <tr>
                <th>
                    Methodology
                </th>

                <td>
                    @(Model.Methodology ?? "-")
                </td>
            </tr>


            <tr>
                <th>
                    Environment
                </th>

                <td>
                    @(Model.Environment ?? "-")
                </td>
            </tr>


            <tr>
                <th>
                    Status
                </th>

                <td>
                    @Model.AssessmentStatusName
                </td>
            </tr>

        </tbody>

    </table>


    @if (!string.IsNullOrWhiteSpace(
        Model.Description))
    {
        <h5 class="mt-4">
            Description
        </h5>

        <p>
            @Model.Description
        </p>
    }

</section>
<section class="report-section">

    <h2 class="report-section-title">
        2. Executive Summary
    </h2>


    <div class="report-summary-grid">

        <div class="report-summary-card">

            <div class="report-label">
                Total Findings
            </div>

            <div class="report-summary-value">
                @Model.TotalFindings
            </div>

        </div>


        <div class="report-summary-card">

            <div class="report-label">
                Open
            </div>

            <div class="report-summary-value">
                @Model.OpenFindings
            </div>

        </div>


        <div class="report-summary-card">

            <div class="report-label">
                Closed
            </div>

            <div class="report-summary-value">
                @Model.ClosedFindings
            </div>

        </div>


        <div class="report-summary-card">

            <div class="report-label">
                False Positive
            </div>

            <div class="report-summary-value">
                @Model.FalsePositiveFindings
            </div>

        </div>

    </div>


    <table class="table table-bordered mt-4">

        <thead>
            <tr>
                <th>Critical</th>
                <th>High</th>
                <th>Medium</th>
                <th>Low</th>
                <th>Informational</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td>@Model.CriticalFindings</td>
                <td>@Model.HighFindings</td>
                <td>@Model.MediumFindings</td>
                <td>@Model.LowFindings</td>
                <td>@Model.InformationalFindings</td>
            </tr>
        </tbody>

    </table>

</section>
<section class="report-section">

    <h2 class="report-section-title">
        3. Authorized Targets & Scope
    </h2>


    @if (!Model.Targets.Any())
    {
        <p>
            No targets were recorded.
        </p>
    }
    else
    {
        @foreach (var target in Model.Targets)
        {
            <div class="finding-report-item">

                <strong>
                    @target.TargetName
                </strong>

                <div>
                    @target.TargetTypeCode:
                    @target.TargetValue
                </div>


                <div class="mt-2">

                    Authorization:
                    <strong>
                        @target.AuthorizationStatusName
                    </strong>

                </div>


                @if (!string.IsNullOrWhiteSpace(
                        target.AuthorizationReference))
                {
                    <div>
                        Reference:
                        @target.AuthorizationReference
                    </div>
                }


                @if (target.ScopeRules.Any())
                {
                    <table class="table table-sm mt-3">

                        <thead>
                            <tr>
                                <th>Rule</th>
                                <th>Value</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (
                                            var rule in
                                            target.ScopeRules)
                            {
                                <tr>
                                    <td>
                                        @rule.ScopeRuleTypeCode
                                    </td>

                                    <td>
                                        @rule.RuleValue
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                }

            </div>
        }
    }

</section>
<section class="report-section">

    <h2 class="report-section-title">
        4. Scan History
    </h2>


    <table class="table table-bordered table-sm">

        <thead>
            <tr>
                <th>Job</th>
                <th>Purpose</th>
                <th>Scanner</th>
                <th>Target</th>
                <th>Status</th>
                <th>Completed</th>
            </tr>
        </thead>


        <tbody>

            @foreach (var job in Model.ScanJobs)
            {
                <tr>

                    <td>
                        @job.JobCode
                    </td>

                    <td>
                        @job.ScanJobPurposeCode
                    </td>

                    <td>
                        @job.ScannerTypeCode
                    </td>

                    <td>
                        @job.TargetValue
                    </td>

                    <td>
                        @job.ScanJobStatusName
                    </td>

                    <td>

                        @(job.CompletedDate.HasValue ? job.CompletedDate.Value.ToString("MMM dd, yyyy HH:mm"): "-")

                </td>

                </tr>
                        }

        </tbody>

    </table>

</section>
<section class="report-section">

    <h2 class="report-section-title">
        5. Detailed Findings
    </h2>


    @if (!Model.Findings.Any())
    {
        <p>
            No findings were identified during this assessment.
        </p>
    }
    else
    {
        var findingNumber = 1;


        @foreach (var finding in Model.Findings)
        {
            <article class="finding-report-item">

                <div class="d-flex justify-content-between">

                    <div>

                        <h4>
                            @findingNumber.
                            @finding.Title
                        </h4>

                        <div class="text-muted">
                            @finding.SourceFindingIdentifier
                        </div>

                    </div>


                    <div class="text-end">

                        <strong>
                            @finding.SeverityName
                        </strong>

                        <div>
                            @finding.FindingStatusName
                        </div>

                    </div>

                </div>


                <hr />


                <h6>Target</h6>

                <p>
                    @finding.TargetValue
                </p>


                <h6>Description</h6>

                <p>
                    @(finding.Description ?? "-")
                </p>


                <h6>Evidence</h6>

                <pre class="report-pre">@(finding.Evidence ?? "-")</pre>


                <h6>Recommendation</h6>

                <p>
                    @(finding.Recommendation ?? "-")
                </p>


                @if (!string.IsNullOrWhiteSpace(
                        finding.Reference))
                {
                    <h6>Reference</h6>

                    <p>
                        @finding.Reference
                    </p>
                }


                @if (finding.Remediations.Any())
                {
                    <h5 class="mt-4">
                        Remediation History
                    </h5>


                    @foreach (
                            var remediation
                            in finding.Remediations)
                    {
                        <div class="border rounded p-3 mb-2">

                            <strong>
                                Cycle
                                @remediation.CycleNo
                            </strong>

                            <div>
                                @remediation.RemediationStatusName
                            </div>

                            <div class="mt-2">
                                @(remediation.RemediationNotes ?? "-")
                            </div>

                        </div>
                    }
                }


                @if (finding.Retests.Any())
                {
                    <h5 class="mt-4">
                        Retest History
                    </h5>


                    @foreach (
                            var retest
                            in finding.Retests)
                    {
                        <div class="border rounded p-3 mb-2">

                            <strong>
                                Cycle
                                @retest.CycleNo
                            </strong>

                            <div>
                                Status:
                                @retest.RetestStatusName
                            </div>

                            <div>
                                Outcome:
                                @(retest.RetestOutcomeName ?? "-")
            </div>

            @if (!string.IsNullOrWhiteSpace(
                        retest.ReviewNotes))
                            {
                                <div class="mt-2">
                                    @retest.ReviewNotes
                                </div>
                            }

                        </div>
                    }
                }

            </article>


            findingNumber++;
        }
    }

</section>
<footer class="report-section border-top pt-3">

    <div class="small text-muted">

        Generated by EVOLVE_VAPT<br />

        Evolve Software Solutions Inc.<br />

        Generated:
        @Model.GeneratedDate.ToString("MMMM dd, yyyy HH:mm")

    </div>

</footer>