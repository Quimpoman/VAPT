@model EVOLVE_VAPT.ViewModels.Assessment.AssessmentDetailsViewModel

@{
    ViewData["Title"] = "Assessment Details";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            @Model.AssessmentName
        </h1>

        <p class="page-description">
            @Model.AssessmentCode
        </p>

    </div>

    <div class="d-flex gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back

        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.AssessmentID"
           class="btn btn-primary">

            <i class="bi bi-pencil me-1"></i>

            Edit

        </a>

        <button type="button"
                class="btn btn-outline-danger"
                data-bs-toggle="modal"
                data-bs-target="#deactivateModal">

            <i class="bi bi-x-circle me-1"></i>

            Deactivate

        </button>

    </div>

</div>


<div class="dashboard-grid">

    <section class="dashboard-panel">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Assessment Information
                </h2>

                <span class="panel-description">
                    General information and lifecycle details.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <div class="detail-grid">

                <div class="detail-item">
                    <span class="detail-label">
                        Assessment Code
                    </span>

                    <span class="detail-value">
                        @Model.AssessmentCode
                    </span>
                </div>


                <div class="detail-item">
                    <span class="detail-label">
                        Status
                    </span>

                    <span class="detail-value">
                        @Model.AssessmentStatusName
                    </span>
                </div>


                <div class="detail-item">
                    <span class="detail-label">
                        Environment
                    </span>

                    <span class="detail-value">
                        @(Model.Environment ?? "-")
                    </span>
                </div>


                <div class="detail-item">
                    <span class="detail-label">
                        Methodology
                    </span>

                    <span class="detail-value">
                        @(Model.Methodology ?? "-")
                    </span>
                </div>


                <div class="detail-item detail-item-full">

                    <span class="detail-label">
                        Description
                    </span>

                    <span class="detail-value">
                        @(Model.Description ?? "-")
                    </span>

                </div>

            </div>

        </div>

    </section>

    <section class="dashboard-panel">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Assignment & Schedule
                </h2>

                <span class="panel-description">
                    Assigned personnel and assessment dates.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <div class="detail-grid">

                <div class="detail-item">
                    <span class="detail-label">
                        Owner
                    </span>

                    <span class="detail-value">
                        @(Model.OwnerEmail ?? "-")
                    </span>
                </div>


                <div class="detail-item">
                    <span class="detail-label">
                        Reviewer
                    </span>

                    <span class="detail-value">
                        @(Model.ReviewerEmail ?? "-")
                    </span>
                </div>


                <div class="detail-item">
                    <span class="detail-label">
                        Planned Start
                    </span>

                    <span class="detail-value">
                        @(Model.PlannedStartDate
                                                ?.ToString("MMM dd, yyyy")
                                                ?? "-")
                    </span>
                </div>


                <div class="detail-item">
                    <span class="detail-label">
                        Planned End
                    </span>

                    <span class="detail-value">
                        @(Model.PlannedEndDate
                                                ?.ToString("MMM dd, yyyy")
                                                ?? "-")
                    </span>
                </div>


                <div class="detail-item">
                    <span class="detail-label">
                        Actual Start
                    </span>

                    <span class="detail-value">
                        @(Model.ActualStartDate
                                                ?.ToString("MMM dd, yyyy")
                                                ?? "-")
                    </span>
                </div>


                <div class="detail-item">
                    <span class="detail-label">
                        Actual End
                    </span>

                    <span class="detail-value">
                        @(Model.ActualEndDate
                                                ?.ToString("MMM dd, yyyy")
                                                ?? "-")
                    </span>
                </div>

            </div>

        </div>

    </section>

    <section class="dashboard-panel dashboard-panel-spacing">

        <div class="panel-header">

            <div class="panel-title-group">

                <h2 class="panel-title">
                    Record Information
                </h2>

                <span class="panel-description">
                    Database creation and last modification information.
                </span>

            </div>

        </div>


        <div class="panel-body">

            <div class="detail-grid">

                <div class="detail-item">

                    <span class="detail-label">
                        Created By
                    </span>

                    <span class="detail-value">
                        @(Model.CreatedByEmail ?? Model.CreatedBy)
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Created Date
                    </span>

                    <span class="detail-value">
                        @Model.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Last Edited By
                    </span>

                    <span class="detail-value">
                        @(Model.EditedByEmail ?? Model.EditedBy ?? "-")
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Last Edited Date
                    </span>

                    <span class="detail-value">

                        @(Model.EditedDate.HasValue ? Model.EditedDate.Value.ToString("MMM dd, yyyy hh:mm tt"): "-")

                    </span>

                </div>

            </div>

        </div>

    </section>

</div>


<div class="dashboard-grid">

    <!-- TARGETS -->
    <section class="dashboard-panel">

        <div class="panel-header">

            <div class="panel-title-group">

                <a asp-controller="Target"
                   asp-action="Index"
                   asp-route-assessmentId="@Model.AssessmentID"
                   class="panel-action">

                    Manage Targets

                    <i class="bi bi-arrow-right"></i>

                </a>

                <span class="panel-description">
                    Authorized targets included in this assessment.
                </span>

            </div>

        </div>


        @if (!Model.Targets.Any())
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    <i class="bi bi-bullseye"></i>
                </div>

                <h3 class="empty-state-title">
                    No targets configured
                </h3>

                <p class="empty-state-description">
                    No targets have been assigned
                    to this assessment.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Target</th>
                            <th>Type</th>
                            <th>Authorization</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (
                                            var target
                                            in Model.Targets.Take(5))
                        {
                            var authorizationClass =
                            target.AuthorizationStatusName switch
                            {
                                "Approved" =>
                                            "bg-success",

                                "Pending" =>
                                            "bg-warning text-dark",

                                "Pending Approval" =>
                                            "bg-warning text-dark",

                                "Rejected" =>
                                            "bg-danger",

                                "Revoked" =>
                                            "bg-danger",

                                _ =>
                                            "bg-secondary"
                            };


                            <tr>

                                <td>

                                    <div>
                                        <strong>
                                            @target.TargetName
                                        </strong>
                                    </div>

                                    <small class="text-muted">
                                        @target.TargetValue
                                    </small>

                                </td>


                                <td>
                                    @target.TargetTypeName
                                </td>


                                <td>

                                    <span class="badge @authorizationClass">
                                        @target.AuthorizationStatusName
                                    </span>

                                </td>


                                <td class="text-end">

                                    <a asp-controller="Target"
                                       asp-action="Details"
                                       asp-route-id="@target.AssessmentTargetID"
                                       class="btn btn-sm btn-outline-primary">

                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            @if (Model.Targets.Count > 5)
            {
                <div class="panel-body border-top">

                    <span class="text-muted">
                        Showing 5 of
                        @Model.Targets.Count targets.
                    </span>

                </div>
            }
        }

    </section>


    <!-- SCAN JOBS -->
    <section class="dashboard-panel">

        <div class="panel-header">

            <div class="panel-title-group">

                <a asp-controller="ScanJob"
                   asp-action="Index"
                   class="panel-action">

                    Scan Jobs

                    <i class="bi bi-arrow-right"></i>

                </a>

                <span class="panel-description">
                    Most recent scanner jobs associated
                    with this assessment.
                </span>

            </div>

        </div>


        @if (!Model.ScanJobs.Any())
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    <i class="bi bi-radar"></i>
                </div>

                <h3 class="empty-state-title">
                    No scan jobs available
                </h3>

                <p class="empty-state-description">
                    Scan jobs will appear here after
                    a scan is requested for this assessment.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Job</th>
                            <th>Scanner / Target</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (
                                            var job
                                            in Model.ScanJobs)
                        {
                            var statusClass =
                            job.ScanJobStatusCode switch
                            {
                                "COMPLETED" =>
                                            "bg-success",

                                "RUNNING" =>
                                            "bg-primary",

                                "QUEUED" =>
                                            "bg-info text-dark",

                                "PENDING_APPROVAL" =>
                                            "bg-warning text-dark",

                                "FAILED" =>
                                            "bg-danger",

                                "BLOCKED" =>
                                            "bg-danger",

                                "REJECTED" =>
                                            "bg-danger",

                                "CANCELLED" =>
                                            "bg-secondary",

                                _ =>
                                            "bg-secondary"
                            };


                            <tr>

                                <td>

                                    <div>
                                        <strong>
                                            @job.JobCode
                                        </strong>
                                    </div>

                                    <small class="text-muted">
                                        @job.RequestedDate.ToString("MMM dd, yyyy hh:mm tt")
                                    </small>

                                </td>


                                <td>

                                    <div>
                                        <strong>
                                            @job.ScannerTypeCode
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        job.ScanProfileName))
                                        {
                                            <span class="text-muted">
                                                · @job.ScanProfileName
                                            </span>
                                        }

                                    </div>

                                    <small class="text-muted">
                                        @job.TargetName
                                        (@job.TargetValue)
                                    </small>

                                </td>


                                <td>

                                    <span class="badge @statusClass">
                                        @job.ScanJobStatusName
                                    </span>

                                </td>


                                <td class="text-end">

                                    <a asp-controller="ScanJob"
                                       asp-action="Details"
                                       asp-route-id="@job.ScanJobID"
                                       class="btn btn-sm btn-outline-primary">

                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>

<div class="modal fade"
     id="deactivateModal"
     tabindex="-1"
     aria-labelledby="deactivateModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="deactivateModalLabel">

                    Deactivate Assessment

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                <p>
                    Are you sure you want to deactivate
                    <strong>@Model.AssessmentCode</strong>?
                </p>

                <p class="text-muted mb-0">
                    The assessment will no longer appear in
                    the active assessment list, but its record
                    and audit history will be retained.
                </p>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>


                <form asp-action="Deactivate"
                      asp-route-id="@Model.AssessmentID"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">

                        Deactivate Assessment

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>