@model EVOLVE_VAPT.ViewModels.Report.AssessmentReportViewModel

@{
    ViewData["Title"] = "Assessment Report";
}
<div class="page-header">

    <div>

        <h1 class="page-title">
            Assessment Report
        </h1>

        <p class="page-description">
            @Model.AssessmentCode -
            @Model.AssessmentName
        </p>

    </div>


    <div class="d-flex gap-2">

        <a asp-action="PrintAssessment"
           asp-route-id="@Model.AssessmentID"
           target="_blank"
           class="btn btn-primary">

            <i class="bi bi-printer me-1"></i>

            Print / Export PDF

        </a>


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back

        </a>

    </div>


</div>
<section class="dashboard-panel">

    <div class="panel-header">

        <h2 class="panel-title">
            Assessment Information
        </h2>

    </div>


    <div class="panel-body">

        <div class="detail-grid">

            <div class="detail-item">

                <span class="detail-label">
                    Assessment Code
                </span>

                <span class="detail-value">
                    @Model.AssessmentCode
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Status
                </span>

                <span class="detail-value">
                    @Model.AssessmentStatusName
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Methodology
                </span>

                <span class="detail-value">
                    @(Model.Methodology ?? "-")
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Environment
                </span>

                <span class="detail-value">
                    @(Model.Environment ?? "-")
                </span>

            </div>

        </div>


        @if (!string.IsNullOrWhiteSpace(
                Model.Description))
        {
            <div class="mt-3">

                <strong>
                    Description
                </strong>

                <div class="mt-1">
                    @Model.Description
                </div>

            </div>
        }

    </div>

</section>
<section class="dashboard-panel dashboard-panel-spacing">

    <div class="panel-header">

        <h2 class="panel-title">
            Executive Summary
        </h2>

    </div>


    <div class="panel-body">

        <div class="row g-3">

            <div class="col-md-3">
                <strong>Total Findings</strong>
                <div class="fs-4">
                    @Model.TotalFindings
                </div>
            </div>

            <div class="col-md-3">
                <strong>Open</strong>
                <div class="fs-4">
                    @Model.OpenFindings
                </div>
            </div>

            <div class="col-md-3">
                <strong>Closed</strong>
                <div class="fs-4">
                    @Model.ClosedFindings
                </div>
            </div>

            <div class="col-md-3">
                <strong>False Positive</strong>
                <div class="fs-4">
                    @Model.FalsePositiveFindings
                </div>
            </div>

        </div>


        <hr />


        <div class="row g-3">

            <div class="col">
                Critical:
                <strong>@Model.CriticalFindings</strong>
            </div>

            <div class="col">
                High:
                <strong>@Model.HighFindings</strong>
            </div>

            <div class="col">
                Medium:
                <strong>@Model.MediumFindings</strong>
            </div>

            <div class="col">
                Low:
                <strong>@Model.LowFindings</strong>
            </div>

            <div class="col">
                Informational:
                <strong>@Model.InformationalFindings</strong>
            </div>

        </div>

    </div>

</section>
<section class="dashboard-panel dashboard-panel-spacing">

    <div class="panel-header">

        <h2 class="panel-title">
            Authorized Targets & Scope
        </h2>

    </div>


    <div class="panel-body">

        @foreach (var target in Model.Targets)
        {
            <div class="border rounded p-3 mb-3">

                <div class="d-flex justify-content-between">

                    <div>

                        <strong>
                            @target.TargetName
                        </strong>

                        <div class="text-muted">
                            @target.TargetTypeCode
                            ·
                            @target.TargetValue
                        </div>

                    </div>


                    <div>
                        @target.AuthorizationStatusName
                    </div>

                </div>


                @if (target.ScopeRules.Any())
                {
                    <div class="mt-3">

                        <strong>
                            Scope
                        </strong>

                        @foreach (
                                        var rule in target.ScopeRules)
                        {
                            <div class="mt-1">

                                <code>
                                    @rule.ScopeRuleTypeCode
                                </code>

                                @rule.RuleValue

                            </div>
                        }

                    </div>
                }

            </div>
        }

    </div>

</section>
<section class="dashboard-panel dashboard-panel-spacing">

    <div class="panel-header">

        <h2 class="panel-title">
            Scan History
        </h2>

    </div>


    <div class="panel-body">

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Job</th>
                        <th>Purpose</th>
                        <th>Scanner</th>
                        <th>Target</th>
                        <th>Status</th>
                        <th>Requested</th>
                        <th>Completed</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var job in Model.ScanJobs)
                    {
                        <tr>

                            <td>
                                @job.JobCode
                            </td>

                            <td>
                                @job.ScanJobPurposeCode
                            </td>

                            <td>
                                @job.ScannerTypeCode
                            </td>

                            <td>
                                @job.TargetValue
                            </td>

                            <td>
                                @job.ScanJobStatusName
                            </td>

                            <td>
                                @job.RequestedDate.ToString("MMM dd, yyyy HH:mm")
                        </td>

                        <td>
                            @(job.CompletedDate.HasValue ? job.CompletedDate.Value.ToString("MMM dd, yyyy HH:mm"): "-")
                        </td>

                        </tr>
                        
                    }

                </tbody>

            </table>

        </div>

    </div>

</section>
<section class="dashboard-panel dashboard-panel-spacing">

    <div class="panel-header">

        <h2 class="panel-title">
            Detailed Findings
        </h2>

    </div>


    <div class="panel-body">

        @if (!Model.Findings.Any())
        {
            <div class="text-muted">
                No findings were identified.
            </div>
        }
        else
        {
            @foreach (var finding in Model.Findings)
            {
                <article class="border rounded p-4 mb-4">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h4 class="mb-1">
                                @finding.Title
                            </h4>

                            <div class="text-muted small">
                                @finding.SourceFindingIdentifier
                            </div>

                        </div>


                        <div class="text-end">

                            <strong>
                                @finding.SeverityName
                            </strong>

                            <div class="small">
                                @finding.FindingStatusName
                            </div>

                        </div>

                    </div>


                    <hr />


                    <strong>
                        Target
                    </strong>

                    <div class="mb-3">
                        @finding.TargetValue
                    </div>


                    <strong>
                        Description
                    </strong>

                    <div class="mb-3">
                        @(finding.Description ?? "-")
                    </div>


                    <strong>
                        Evidence
                    </strong>

                    <pre class="text-wrap mb-3">@(finding.Evidence ?? "-")</pre>


                    <strong>
                        Recommendation
                    </strong>

                    <div class="mb-3">
                        @(finding.Recommendation ?? "-")
                    </div>

        @if (finding.Remediations.Any())
        {
                        <hr />

                        <h5>
                            Remediation History
                        </h5>


            @foreach (
                        var remediation in
                        finding.Remediations)
            {
                            <div class="border rounded p-3 mb-2">

                                <strong>
                                    Cycle @remediation.CycleNo
                                </strong>

                                <div>
                                    @remediation.RemediationStatusName
                                </div>

                                <div class="mt-2">
                                    @(remediation.RemediationNotes
                                                        ?? "No remediation notes.")
                </div>

                            </div>
            }
        }

                    @if (finding.Retests.Any())
                    {
                        <hr />

                        <h5>
                            Retest History
                        </h5>


                        @foreach (
                                    var retest in finding.Retests)
                        {
                            <div class="border rounded p-3 mb-2">

                                <strong>
                                    Cycle @retest.CycleNo
                                </strong>

                                <div>
                                    @retest.RetestStatusName
                                </div>

                                <div>
                                    Outcome:
                                    @(retest.RetestOutcomeName
                                                        ?? "-")
                </div>

                @if (!string.IsNullOrWhiteSpace(
                                retest.ReviewNotes))
                                {
                                    <div class="mt-2">
                                        @retest.ReviewNotes
                                    </div>
                                }

                            </div>
                        }
                    }

                </article>
            }
        }

    </div>

</section>